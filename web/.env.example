# Environment variables for Scrocco web panel
# Copy to .env and customize:
#   cp .env.example .env
#
# All variables are optional unless marked Required.

# --- Required ---
DATABASE_URL=postgres://user:***@localhost:3001/scrocco
JWT_SECRET=change-me-to-a-random-string
GATEWAY_MASTER_KEY=change-me-to-a-random-string

# --- Server ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Session ---
APP_NAME=scrocco-web
COOKIE_SECURE=0        # 1 solo se il pannello e' servito via HTTPS
SESSION_COOKIE_NAME=token
JWT_EXPIRES_IN=1d

# --- Bootstrap admin ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- SMTP (email sending) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=scrocco@example.com
MAGIC_LINK_BASE_URL=http://localhost:3000

# --- Gateway ---
GATEWAY_URL=http://scrocco-llm:4001
GATEWAY_MOCK=false

# --- Alert / Telegram ---
TELEGRAM_BOT_TOKEN=
ALERT_POLLER_DISABLED=0
