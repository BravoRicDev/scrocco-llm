# ============================================================
# scrocco-llm · .gitignore
# REGOLA D'ORO: nessun segreto, nessun dato live, mai.
# (var/ e .env.gateway non sono MAI entrati nella storia git)
# ============================================================

# ---- SEGRETI E DATI LIVE -------------------------------------------
# var/* con negazione: gli .example sono il template pubblico del repo
var/*
!var/*.example
.env.gateway
.env*
!.env.example
!.env.gateway.example
*.key
*.pem
*.session

# ---- BACKUP / STATO RUNTIME ----------------------------------------
*.bak
*.bak.*
*.tmp
*.orig
*.rej
var_backup*/
backups/

# ---- SVILUPPO PYTHON ------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
build/
dist/

# ---- SISTEMA / EDITOR -----------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# ---- DOCKER / DEPLOY LOCALE -----------------------------------------
docker-compose.override.yml
docker-compose.*.local.yml

# ---- NOTE DI LAVORO (non pubblicabili) ------------------------------
NOTES.md
TODO_PRIVATE.md
scratch/

# ---- SCRocCO-WEB (Node.js + Express) -------------------------------------------
web/node_modules/
web/.env
web/var/
web/backups/
