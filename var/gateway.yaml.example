# ═════════════════════════════════════════════════════════════════════════════
# scrocco-llm · POLICY GATEWAY (template di default)
# ═════════════════════════════════════════════════════════════════════════════
#
# Questo file riflette la policy LIVE attualmente in produzione e funge da
# TEMPLATE di default: copialo in `var/gateway.yaml` per un nuovo deploy e
# personalizza profili/alias secondo le tue esigenze.
#
# TUTTE le sezioni sono OPZIONALI: se una chiave è omessa viene usato il
# default hardcoded in `app/policy.py`. I valori qui sotto sono quelli
# verificati e messi in produzione (2026-08-29).
#
# IMPORTANTE: qui NON vanno mai messi segreti. Le chiavi vivono in
# `var/keys_rotation.csv` (deterministiche sk-<profilo>) o in `client_keys`
# sotto (override), MAI in questo file di configurazione versionato.

# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURAZIONE GENERALE
# ─────────────────────────────────────────────────────────────────────────────

# Step-up globale: quando un deployment fallisce, di quanto penalizzare il suo
# punteggio per la prossima selezione.
#   100 = disabilitato (nessuna penalità)
#   <100 = più aggressivo (ruota prima verso altri candidati)
step_up_pct: 100

# ─────────────────────────────────────────────────────────────────────────────
# PROFILI — override per-profilo dei default globali
# ─────────────────────────────────────────────────────────────────────────────
# Ogni profilo (tenant) può avere la propria configurazione. Il nome del
# profilo coincide con le colonne `scrocco-llm-<profilo>` in keys_rotation.csv.
profiles:
  # Profilo di esempio. Rinomina/rimuovi per i tuoi profili reali.
  myteam:
    # Step-up percentuale specifico per questo profilo (qui: come il globale)
    step_up_pct: 100

# ─────────────────────────────────────────────────────────────────────────────
# STIMA TOKEN & COMPORTAMENTO STICKY
# ─────────────────────────────────────────────────────────────────────────────

# Divisore per stimare i token dai caratteri del payload (chars / divisor).
#   4 = approssimazione standard (1 token ≈ 4 caratteri)
#   3 = più conservativo (stima più alta → contesto più ampio)
# NB: il traffico opencode reale misura ~3.9 char/token: con 3 la stima
# sovrastimava del ~29% e faceva salire di dim (fuori dal tier zen/free)
# richieste che ci sarebbero entrate. Default realistico = 4.
estimate_divisor: 4

# Calibrazione closed-loop dell'estimator: a ogni risposta con usage reale
# (prompt_tokens) il divisor appreso del deployment si muove verso quello vero
# (base/rapporto) con EMA alpha. 0 = calibrazione spenta.
estimate_calib_alpha: 0.05

# STIMA PER-SESSIONE (char/token REALE): il 1o turno di una sessione usa la
# stima euristica (char/estimate_divisor); dal 2o si apprendono DUE rapporti
# dagli stessi campioni (media cumulativa per sessione, in-memory):
#   cpt_post = char EFFETTIVAMENTE inviati al provider / prompt_tokens
#              (tokenizer vero; stima PRE-compressione per sicurezza/overflow);
#   cpt_pre  = char della preview pre-ctxcompact / prompt_tokens
#              (predice i token POST-compressione -> scelta della dim).
# La base di stima e' la preview con sola histnorm, cosi' i char coincidono
# tra apprendimento e routing. Testo e codice restano separati.
session_estimate_enabled: true
session_estimate_margin: 1.05       # +5% di sicurezza
session_estimate_min_chars: 8000    # scarta campioni troppo piccoli
session_estimate_min_tokens: 1000
session_estimate_ttl_sec: 3600      # 0 = nessuna scadenza
session_estimate_min_ratio: 1.5     # clamp inferiore char/token
session_estimate_max_ratio: 12.0    # clamp superiore (copre anche cpt_pre)

# ROLLOUT AUTOMATICO DELLA STIMA ADATTIVA
#   estimate_adaptive_enabled = master switch manuale (vince sempre).
#   In shadow i due conteggi (legacy/adattivo) vengono accumulati e ORA
#   persistono in adaptive_stats.json: sopravvivono ai restart, quindi il
#   rollout si chiude da solo senza dover "cacciare" una finestra di traffico
#   tra un deploy e l'altro.
#   auto_enable: quando i campioni shadow sono >= auto_min_n e lo scarto medio
#   e' entro auto_max_delta_pct, la stima adattiva entra in uso da sola.
estimate_adaptive_auto_enable: true
estimate_adaptive_auto_min_n: 200
estimate_adaptive_auto_max_delta_pct: 5.0

# Concorrenza PESATA A TOKEN (non a conteggio): una richiesta viene esclusa
# dal deployment se inflight_tokens + ctx_est > max_input * conc_token_ratio.
# 0.5 = un heavy non parte se un altro prefill e' gia' in volo sullo stesso
# deployment, mentre N richieste leggere passano in parallelo. 0 = torna al
# conteggio storico (conc_default_limit / conc_max_limit / concurrent_limit).
conc_token_ratio: 0.5

# TTL in secondi dell'affinità "sticky": lo stesso deployment viene preferito
# per richieste consecutive della stessa sessione.
#   3600 = 1 ora ; 0 = sticky disabilitato
sticky_ttl_sec: 3600
# Campi client-only NON standard rimossi dal body prima dell'invio a monte
# (es. le opzioni degli agenti opencode come `fallback_models`, che i provider
# severi tipo Google via /v1beta/openai rifiutano con 400 "Unknown name").
# Default: [fallback_models]
# strip_client_fields: [fallback_models]

# Coalescing delle richieste IDENTICHE (stesso payload+profilo, non-streaming)
# gia' in volo: una sola chiamata upstream, risposta condivisa (deepcopy).
# request_coalescing_cache_sec estende il concetto DOPO il completamento: un
# payload identico che arriva entro N secondi riceve la risposta gia' prodotta
# (retry ravvicinati e subagenti pagano meta'). 0 = solo in-flight (default).
# request_coalescing_enabled: true
# request_coalescing_ttl_sec: 60
# request_coalescing_max_waiters: 10
# request_coalescing_cache_sec: 0

# --- SOFT-SKIP PER CHIAVE DAI RATE HEADERS (zero colpa) -------------------
# rate_hint_*: l'ultimo snapshot (TTL breve) dei rate headers X-RateLimit-*
# viaggia per CHIAVE (hash, mai in chiaro). Se una chiave e' quasi al muro
# (remaining <= rate_hint_remaining_max) il deployment che la usa viene solo
# SALTATO nella scelta dei free-dim: nessun cooldown, nessuna penalita' di
# reputazione, le altre chiavi della stessa riga restano eleggibili.
# key_soft_429: un 429 con Retry-After R oscura SOFTMENTE tutte le righe che
# condividono quella api_key per max(R, ...) <= key_soft_max_sec secondi
# (durata reale del muro dell'upstream, non il cooldown classico).
# rate_hint_proven_sec/budget_guard.suppress_with_headers: se la chiave
# MANDA header di quota freschi, i cap appresi dal budget_guard vengono
# ignorati (l'header e' la fonte di verita', l'apprendimento era un ripiego).
rate_hint_skip_enabled: true
rate_hint_ttl_sec: 20.0
rate_hint_remaining_max: 5
rate_hint_proven_sec: 900.0
key_soft_429_enabled: true
key_soft_max_sec: 900

# Al failover verso un deployment della STESSA FAMIGLIA, sposta lo sticky sul
# nuovo deployment (prompt cache calda preservata).
sticky_handoff_same_family: true

# Sessioni anonime (client che non inviano alcun id di sessione, es. Hermes):
# il gateway deriva un id deterministico `fq_<hash>` dal prefisso della
# conversazione (system + primo messaggio user + user-agent) per abilitare
# sticky e cache-aware. false = lascia la sessione anonima (storico).
anon_session_fingerprint: true

# Il fingerprint anonimo considera solo i primi N caratteri del system prompt
# (0 = tutto il prompt): evita che timestamp/dati di contesto accodati ad ogni
# turno cambino l'id sessione, mantenendo sticky e prompt-cache calde.
anon_session_fp_system_chars: 768

# Cooldown base in secondi per chiavi/modelli che falliscono (600 = 10 minuti).
# Vedere anche `cooldown_mode` più sotto per l'escalation.
cooldown_sec: 600

# Floor minimo del cooldown applicato sui 429 (anti-loop): il valore del
# provider viene ignorato se piu' piccolo. Override per-provider opzionale.
# retry_after_min_sec: 10
# retry_after_floor_by_provider:
#   groq: 5
#   google: 30
#   openrouter: 15

# Probe passivo delle chiavi dormienti: quando NON ci sono chiavi vive, un
# deployment in cooldown da >= cooldown_probe_after_ratio del suo tempo viene
# ritentato come "probe". Successo -> cooldown azzerato subito; fallimento ->
# cooldown raddoppiato (senza toccare le altre richieste). `decay` fa decadere
# linearmente la penalita' (EMA latenza/successo) col passare del tempo.
cooldown_probe_enabled: true
cooldown_probe_after_ratio: 0.5
cooldown_probe_decay: true

# Decadimento del fail_streak in inattivita' (halflife in secondi): dopo N
# secondi senza fallimenti lo streak si dimezza (0 = off).
cooldown_streak_halflife_sec: 1800
# Auto-retirement dopo N probe passivi consecutivi falliti (0 = off).
probe_retire_after: 5
# Anti "thundering herd" sui cooldown.
# - cooldown_jitter_sec_max (default 2.0): spread DETERMINISTICO per-unique
#   (sha256(unique) -> 0..2s) aggiunto a OGNI cooldown e alla scadenza del
#   key-soft 429. Non e' random e non cambia tra restart: i gemelli della
#   stessa chiave non scadono piu' nello stesso millisecondo.
# - cooldown_jitter_ratio: vecchio jitter moltiplicativo RANDOM, spento di
#   default (0.12 = +/-12%; 0 = off).
cooldown_jitter_ratio: 0.0
cooldown_jitter_sec_max: 2.0
# Autoprobe dei cooldown triggerato da una chiamata (solo gruppi -dim testo):
# sonda i dormienti piu' "pronti"; OK = sveglia il deployment; KO = il residuo
# ALMENO RADDOPPIA (con minimo +grow) e i bersagli ruotano. L'autoprobe non
# insiste mai: i residui lunghi li rivedra' la scala che risveglia i cooldown
# (fra -dim e -go) o l'ULTIMA SPIAGGIA. Non rallenta mai la risposta live.
cooldown_autoprobe_enabled: true
cooldown_autoprobe_per_dim: 1
cooldown_autoprobe_min_age_sec: 300
cooldown_autoprobe_grow_sec: 120
cooldown_autoprobe_min_gap_sec: 60
cooldown_autoprobe_max_total: 3
cooldown_autoprobe_timeout_sec: 20
# Moltiplica l'incremento KO per il numero di probe fatti su quel deployment
# nelle ultime 24h (1o=1x, 2o=2x, 3o=3x...): meno richieste ravvicinate inutili.
cooldown_autoprobe_multiply_24h: true
# Esclude del tutto dai probe i deployment con cooldown residuo > N sec (2h):
# li rivedra' il tempo o l'ULTIMA SPIAGGIA. 0 = nessuna esclusione.
cooldown_autoprobe_skip_over_sec: 7200
# La stessa CHIAVE (anche su deployment diversi, i "gemelli") non torna in
# sonda prima di questo gap: l'autoprobe non martella lo stesso conto.
# 0 = nessun vincolo per-chiave.
cooldown_autoprobe_key_gap_sec: 3600
# BUDGET PROBE/24h PER CHIAVE: molti free-tier (openrouter, llm7...) contano
# le RICHIESTE/giorno, non i token. Con N modelli sulla stessa chiave un probe
# per deployment la satura "solo per vedere se e' viva": qui si contano i
# probe realmente fatti per chiave nelle 24h e si smette al cap. Il pool di
# chiavi e' condiviso fra piu' server (stato locale per-host), quindi il
# valore e' VOLUTAMENTE basso. 0 = nessun cap giornaliero.
cooldown_autoprobe_key_day_max: 2
# Se una chiave ha servito TRAFFICO REALE con successo da meno di questo
# tempo, e' viva: sondarla e' spreco di quota -> si salta. 0 = mai.
cooldown_autoprobe_key_ok_fresh_sec: 43200
# Dopo un probe che torna 429/quota la CHIAVE e' bloccata per 24h: non si
# provano altri modelli della stessa chiave (la quota e' per chiave, non per
# modello). Su errori non-quota si puo' provare un altro modello, sempre
# dentro il budget giornaliero.
# GIRO GIORNALIERO SUI RITIRATI: nessun ritiro e' definitivo. Al primo tick
# dopo mezzanotte locale l'autoprobe sonda TUTTI i ritirati in sequenza, con
# calma (retired_gap_sec fra un probe e l'altro) e rispettando il budget
# per-chiave: un probe riuscito li riabilita. In alternativa li puo' usare la
# ULTIMA SPIAGGIA (solo ritirati NON permanenti: mai 401/403/modello morto).
cooldown_autoprobe_retired_enabled: true
cooldown_autoprobe_retired_gap_sec: 20
# Time-decay dei punteggi di reputazione (halflife in secondi; 0 = off).
reputation_decay_halflife_sec: 129600
# Timeout upstream adattivo per-deployment (solo percorso chat):
# read = clamp(max(floor, avg_latency * multiplier), floor, max).
adaptive_timeout_enabled: true
adaptive_timeout_floor_sec: 15
adaptive_timeout_multiplier: 8
adaptive_timeout_max_sec: 600

# WATCHDOG ANTI-STALL del flusso in streaming. Base: nessun byte per
# stream_stall_sec secondi -> lo stream e' considerato morto e si ruota.
# CALIBRATO SUL PREFILL: stall = max(stream_stall_sec, min(TTFT_p50_bucket *
# mult, max_sec)). I light restano reattivi; gli heavy (>128k, prefill 4-6s
# fisiologici) non vengono uccisi a meta' prefill. Bucket vuoto -> base.
stream_stall_sec: 20.0
stream_stall_ttft_mult: 2.5
stream_stall_max_sec: 60.0

# ─────────────────────────────────────────────────────────────────────────────
# HOTWORDS — rilevamento intent "deep think" per routing preferenziale
# ─────────────────────────────────────────────────────────────────────────────

# Quante occorrenze di hotword servono per attivare il routing "pensaci bene"
hotwords_window: 3

# Pattern regex per rilevare richieste di ragionamento profondo
# (la richiesta viene instradata verso modelli "reasoning" se disponibili)
hotwords:
  - pensaci\s+bene
  - pensa\s+a\s+fondo
  - \bragiona\b
  - deep\s*think

# ─────────────────────────────────────────────────────────────────────────────
# MODELLO NELLE RISPOSTE NON-STREAMING
# ─────────────────────────────────────────────────────────────────────────────
# Quale nome di modello restituire al client nella risposta.
#   upstream  (default) -> nome scritto dal PROVIDER
#   deployment         -> unique (nome del deployment usato)
#   requested          -> nome richiesto dal client
response_model: upstream

# ─────────────────────────────────────────────────────────────────────────────
# ROTAZIONE ADATTIVA PREVENTIVA (anti rate-limit, anti saturazione)
# ─────────────────────────────────────────────────────────────────────────────

# Se true, il router adatta dinamicamente la scelta dei deployment basandosi
# su latenza osservata, errori e "recency" d'uso (vedi sotto).
adaptive_pick: true

# Half-life in secondi per la "recency": i deployment usati di recente vengono
# penalizzati nel punteggio, favorendo la distribuzione del carico.
recency_halflife_sec: 20

# Latency di riferimento in ms per il scoring adattivo (peso relativo alla
# latenza media osservata dagli altri deployment del pool).
latency_ref_ms: 1500

# STICKY PER-DEPLOYMENT nei bucket FREE (dims -Nk, cap groups primari): la
# stessa sessione resta incollata alla STESSA API KEY finche' e' viva (non
# in cooldown, contesto sufficiente). WHY: la cache prompt dei provider e'
# per-key; ruotare ogni turn (recency 20s) la invalida e, sui piani flat a
# budget mensile (Go/Zen), fa consumare i token come "input pieno" invece
# che come "cache read" (30x+ piu' caro). Al fallimento il cooldown sposta
# la sessione su un'altra key e li' si riàncora.
deployment_sticky: true

# Halflife "recency" DEDICATO ai bucket -go e -fallback (abbonamenti flat /
# chiavi a pagamento): un valore grande (default 300s = 5min) fa restare la
# sessione sulla stessa key per minuti (cache calda turn-to-turn), mentre la
# distribuzione avviene a grana di sessione -> tutti gli abbonamenti si
# consumano insieme, nessuno prima degli altri. Non usare valori piccoli
# qui: ricrei il problema della cache (consumi 20x il budget mensile).
go_recency_halflife_sec: 300

# ─────────────────────────────────────────────────────────────────────────────
# EFFORT / REASONING — bias di routing verso l'intelligence
# ─────────────────────────────────────────────────────────────────────────────
# Quando il client invia `reasoning_effort` (low/medium/high) il router
# moltiplica il punteggio (lower-is-better) dei deployment in base al loro
# `intelligence_score` (colonna CSV, 1-10):
#   high   -> score *= (1 - (intel-5)*w)   favorisce i piu' intelligenti
#   low    -> score *= (1 + (intel-5)*w)   favorisce i piu' leggeri
#   medium -> score *= (1 + |intel-5|*w)   favorisce il centro della scala
# `effort_intel_weight` e' l'ampiezza del bias (0 = disabilita).
# Il forwarder inietta `reasoning_effort` SOLO sui deployment effort_capable
# (colonna CSV) e applica gli override di temperatura SOLO se il client non
# ha inviato `temperature` (il client vince sempre). Su host incompatibili
# (es. Groq) il parametro viene rimosso.
enable_effort_temperature_override: true
effort_temperature_overrides:
  low: 1.0
  medium: 0.7
  high: 0.2
effort_intel_weight: 10

# ─────────────────────────────────────────────────────────────────────────────
# THOUGHT SIGNATURE (Gemini) — riempimento dummy per storico non firmato
# ─────────────────────────────────────────────────────────────────────────────
# Google pretende una `thought_signature` sui functionCall del turno corrente.
# Se lo storico contiene tool-call non firmate (es. prodotte da altri modelli),
# la richiesta viene ESCLUSA da Gemini a monte, come una capability mancante
# (niente tentativi "finti"). Con thought_sig_dummy_fill=true, al posto
# dell'esclusione si inietta una firma DUMMY ufficiale che SALTA la
# validazione (Google la documenta come last resort: il reasoning degrada).
thought_sig_dummy_fill: true
thought_sig_dummy_value: skip_thought_signature_validator

# ─────────────────────────────────────────────────────────────────────────────
# DYNAMIC SCORING — punteggio contestuale per-deployment (latency p95, error rate, throughput)
# ─────────────────────────────────────────────────────────────────────────────
# Il router mantiene statistiche per-deployment (latency_history, recent_failures,
# recent_attempts, total_tokens, total_duration_ms) e aggiusta il punteggio di
# reputazione con tre componenti (pesi configurabili):
#   1) latency_p95_weight  * (p95_ms / 1000)       -> penalizza latenza alta
#   2) error_rate_weight   * (fail/attempt * 100)   -> penalizza error rate
#   3) throughput_weight   * (tok/sec / 100)        -> premia throughput alto
# Tutti i pesi default > 0: un deployment veloce, affidabile e con alto
# throughput riceve un punteggio MIGLIORE (piu' negativo = better).
dynamic_scoring:
  enabled: true
  latency_p95_weight: 1.0
  error_rate_weight: 2.0
  throughput_weight: 0.5

# ─────────────────────────────────────────────────────────────────────────────
# CIRCUIT BREAKER PER API KEY — previene martellamento chiavi rotte/esauste
# ─────────────────────────────────────────────────────────────────────────────
# Traccia fallimenti consecutivi PER API KEY (tutti i deployment che la usano).
# - chiuso (closed): funziona normalmente
# - aperto (open): salta TUTTI i deployment con quella chiave per N secondi
# - half-open: permette pochi tentativi per verificare se la chiave e' guarita
# threshold: fallimenti consecutivi per aprire (default 5)
# timeout: secondi prima di passare a half-open (default 60)
# half_open_requests: successi richiesti in half-open per chiudere (default 3)
# scope: hybrid = breaker per-deployment (errori modello/provider) + breaker
#        per-chiave solo per segnali di chiave (401/402/403/429);
#        "dep" | "key" forzano un solo livello.
circuit_breaker:
  enabled: true
  threshold: 5
  timeout: 60
  half_open_requests: 3
  scope: hybrid

# Base aggiunta a |score| cosi' model_preference conta anche a freddo
# (0 = solo moltiplicativa storica; default 10).
model_preference_base: 10.0

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT STICKY PER CAPABILITY — sticky separato per capability richiesta
# ─────────────────────────────────────────────────────────────────────────────
# Quando deployment_sticky_per_capability=true, le sessioni restano attaccate
# allo stesso deployment PER CAPABILITÀ RICHIESTA (es. text, vision, stt).
# Così una sessione che fa solo testo resta sulla stessa key, ma se poi chiede
# vision può usare un deployment diverso senza rompere lo sticky del testo.
# DEFAULT false per compatibilità (sticky classico per-sessione).
deployment_sticky_per_capability: false

# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY — Trace ID, JSON logging, Prometheus /metrics, Replay
# ─────────────────────────────────────────────────────────────────────────────
# Controllabile via env vars (precedenza su gateway.yaml):
#   GATEWAY_OBSERVABILITY=0 disabilita tutto
#   GATEWAY_JSON_LOGGING=1 abilita formatter JSON su stdout
#   GATEWAY_TRACE_HEADER=X-Request-ID header per trace ID
# Endpoint:
#   GET /metrics           # Prometheus text exposition
#   GET /admin/replay      # Buffer replay richieste (debug)
#   DELETE /admin/replay   # Pulisce buffer replay
# observability:
#   enabled: true
#   json_logging: false
#   trace_header: "X-Request-ID"

# ─────────────────────────────────────────────────────────────────────────────
# ESCALATION WINNER — scorciatoia SOLO-IN-SALITA, trasversale alla sessione
# ─────────────────────────────────────────────────────────────────────────────
# Problema: una richiesta partita da un bucket piccolo (es. -200k) che trova
# quel bucket tutto in errore SALTA verso gruppi piu' alti (-1000k -> -go).
# Una volta atterrato su un deployment che risponde, senza questa feature la
# richiesta DOPO riparte da -200k e rifà tutta la scala di fallimenti (minuti).
# Con escalation_pin=true: ricordiamo, PER IL BUCKET RICHIESTO, il deployment
# vincente e lo usiamo come SCORCIATOIA DEL FALLBACK (mai del primo pick: il
# bucket economico e' sempre tentato per primo). Il pin scade dopo N secondi
# DALL'ULTIMA richiesta buona (finestra scorrevole), e si pulisce subito se il
# bucket richiesto torna a servire da solo o se il winner fallisce. Solo in
# salita, mai in discesa. Memoria RUNTIME: non viene persistita (il restart la
# riapprende alla prima salita buona).
escalation_pin: true
escalation_pin_ttl_sec: 300

# RICAMPIONAMENTO PRE-PIN: prima di usare la scorciatoia verso il winner
# (tipicamente -go), la richiesta riprova 1 volta la dim richiesta e sonda fino
# a `escalation_pin_probe_dims` dim INTERMEDIE (tra richiesta e winner, winner
# escluso) scelte a caso. Se una è "guarita" la si usa; se sono tutte in
# cooldown vengono saltate (costo zero) e si va al winner.
#   escalation_pin_probe_dims: 0 = disabilita (salto diretto al winner)
escalation_pin_probe_dims: 2
escalation_pin_probe_retry: true    # 1 retry extra nella dim richiesta
escalation_pin_probe_random: true   # scelta casuale delle dim intermedie

# ── L1/L2 intelligent defaults (modelli deboli) ────────────────────────────
history_normalize:
  enabled: true
  tail_only: true            # cache-safe: tocca solo la coda (verificato)
  drop_orphan_tool: true
  drop_dangling_tool_calls: true
  drop_empty_assistant: true
  dedupe_system: true
  # reasoning_content dei turni VECCHI (sopra la frontiera del ctxcompact
  # concettuale: tutto tranne gli ultimi reasoning_keep_recent assistant):
  # 0 = rimosso del tutto, >0 = tagliato a N char con marker, -1 = mai toccare.
  # I thinking di R1/Qwen pesano 5-15k token a turno: dopo servono a poco.
  reasoning_content_max_chars: 0
  reasoning_keep_recent: 1
sampling_defaults:
  enabled: true
  allow_providers: ["*"]
  provider_params:
    "*":
      top_p: 0.95            # solo se il client non lo invia (client vince)
  loop:
    enabled: true
    ngram_size: 8
    repeats: 3
    toolcall_repeat: 2
    min_tokens: 16
corrective_retry:
  enabled: true
  max_attempts: 1            # 1 retry correttivo, solo non-streaming
text_toolcall:
  enabled: true
  require_declared_name: true
  max_bytes: 200000
  hold_until_close: true
  fallback_to_escalation: true

# ─────────────────────────────────────────────────────────────────────────────
# TOOLCALL TRUNCATION — tag tool-call aperto e mai chiuso
# ─────────────────────────────────────────────────────────────────────────────
# Una risposta che si chiude con un tag tool-call APERTO e mai chiuso
# (es. "...<tool_call>{"name":"bash","args":{") e' TRONCATA o allucinata.
# Il gateway TRATTIENE la coda (holdback) cosi' il tag rotto non raggiunge
# MAI il client, poi:
#   - se riesce a estrarre nome (fuzzy sui tools dichiarati) + args, chiude il
#     JSON e inietta una `tool_calls` STRUTTURATA (finish_reason=tool_calls):
#     l'agente esegue il tool e CONTINUA a lavorare;
#   - se non salvabile, scarta il tag e ruota in modo trasparente (nessun byte
#     rotto inviato).
# In entrambi i casi il deployment va in cooldown breve.
# Agnostic rispetto al client: non serve che il client sappia nulla.
toolcall_truncation:
  enabled: true
  cooldown_sec: 30
  holdback: true

# ─────────────────────────────────────────────────────────────────────────────
# ALIAS KEYS — chiavi custom per alias generici (MAI esposte via API)
# ─────────────────────────────────────────────────────────────────────────────
# Mappa chiave -> nome modello per consentire a un client di autenticarsi con
# una chiave dedicata. Decommenta e personalizza:
# alias_keys:
#   mio-modello: sk-xxxxxxxxxxxxxxxx
#   altro-alias: sk-yyyyyyyyyyyyyyyy

# ─────────────────────────────────────────────────────────────────────────────
# CLIENT KEYS — override delle chiavi deterministiche per profilo
# ─────────────────────────────────────────────────────────────────────────────
# Se un profilo ha l'override qui, la chiave deterministica `sk-<profilo>`
# viene DISATTIVATA per quel profilo (la chiave custom la SOSTITUISCE).
# Decommenta e personalizza (segreti: NON versionare, restano in var/):
# client_keys:
#   example: sk-EXAMPLE-KEY-001
#   altro-profilo: sk-altra-chiave-002

# ─────────────────────────────────────────────────────────────────────────────
# HEALTH PROATTIVO — verifica periodica modelli via GET /models (zero token)
# ─────────────────────────────────────────────────────────────────────────────

# I modelli assenti dal provider vengono messi in cooldown preventivamente.
proactive_health: false

# Intervallo in secondi tra i controlli health (1800 = 30 minuti).
health_interval_sec: 1800

# ─────────────────────────────────────────────────────────────────────────────
# COOLDOWN ESCALATION — le chiavi morte non vengono ri-provate per sempre
# ─────────────────────────────────────────────────────────────────────────────
# Due modalità (si escludono a vicenda):
#   escalation : esponenziale — cooldown_sec * 2^(streak-1), fino a
#                max_cooldown_sec (legacy, sotto per compatibilità)
#   linear     : lineare — cooldown_base_min minuti, poi +cooldown_linear_mult_min
#                per ogni fallimento consecutivo (attuale in produzione)
cooldown_mode: linear
cooldown_base_min: 30            # esclusione iniziale in minuti
cooldown_linear_mult_min: 30     # incremento per fallimento consecutivo
# cooldown_escalation: true      # (solo se cooldown_mode=escalation)
# max_cooldown_sec: 18000        # tetto cooldown (5h; default 18000)

# CLASSI DI ERRORE (cooldown + reputazione differenziati).
# - 429/quota: la CHIAVE e' satura, non "cattiva" -> soft blackout per-chiave
#   (sotto) e NESSUNA penale di reputazione; il cooldown usa il Retry-After
#   (header O body JSON: "retry_after": 20, "retryDelay": "58s",
#   "retry in 58s", "try again in 45s" — floor retry_after_min_sec).
# - 503/529 e 500/timeout: guasto TRANSITORIO -> solo il deployment va in
#   pausa breve (cooldown_transient_sec / cooldown_timeout_sec), la chiave
#   non perde reputazione. Un `seconds` ESPLICITO (Retry-After, sonda,
#   anti-black-hole) vince sempre e non viene accorciato.
# - 401/402/403: livello chiave, come sempre.
error_class_cooldowns: true
cooldown_transient_sec: 15
cooldown_timeout_sec: 60

# CIRCUIT BREAKER PROATTIVO PER MODELLO (5xx sistematici su piu' chiavi).
# Se >= model_circuit_keys chiavi DISTINTE dello stesso provider|modello
# falliscono con 5xx entro model_circuit_window_sec, il modello intero viene
# saltato (soft skip, nessuna penale) per model_circuit_open_sec. I breaker
# per-chiave e per-deployment restano invariati.
model_circuit_enabled: true
model_circuit_keys: 3
model_circuit_window_sec: 60
model_circuit_open_sec: 60

# TIMEOUT = DANNO REALE: un modello che "appende" senza rispondere (né errore
# né contenuto) fa perdere tempo (fino a stream_first_content_ms per richiesta).
# `timeout_cooldown_mult` si applica SOLO con error_class_cooldowns=false
# (percorso storico: cooldown del timeout = mult x quello classico, poi
# clampato a max_cooldown_sec). Con le classi attive il timeout usa
# cooldown_timeout_sec. 1 = nessuna penalizzazione extra.
timeout_cooldown_mult: 10

# Dopo quanto (sec) un deployment in cooldown per "stale" può essere riprovato.
stale_cooldown_retry_sec: 300

# Numero massimo di tentativi di fallback lungo la catena/ladder per richiesta.
max_fallback_tries: 128

# ─────────────────────────────────────────────────────────────────────────────
# LADDER — rotazione tra gruppi di contesto quando un livello si satura
# ─────────────────────────────────────────────────────────────────────────────

# Dopo quanti fallimenti nel livello corrente si salta al gradino successivo.
ladder_skip_after: 10

# Soglia di deployment "stale" oltre la quale il ladder scatta.
ladder_stale_max: 3

# Quanti risvegli di dim in cooldown provare (nell'ordine dal residuo minore)
# PRIMA di salire a -go (0 = nessuno, come prima). SOLO dim il cui ultimo
# fallimento e' di QUOTA/429: una chiave satura e' viva, il cooldown puo'
# essere piu' lungo della finestra di quota; un dim raffreddato da 503/timeout NON
# viene riesumato qui (lo fanno autoprobe/ultima spiaggia). Il budget e' A
# FINESTRA per deployment: dopo N risvegli in window_sec non si riprova.
ladder_cooldown_wakeups: 20
ladder_cooldown_wakeup_window_sec: 3600

# SOGLIA "LENTO" SIZE-AWARE (B3 ibrida): "lento" = oltre
#     max(abs_floor_ms, rel_mult * atteso)
# dove l'atteso per QUELLA taglia di contesto e': mediana di FLOTTA nel bucket
# (min_peers campioni) -> mediana globale -> stima dal rate (prefill token/s
# e, a fine stream, generazione token/s) -> 90s legacy. Un 128k che risponde
# in 100s e' NORMALE, non lento: cosi' non si demota/caccia in continuazione
# bruciando quota free-tier.
slow_latency_abs_floor_ms: 30000
slow_latency_rel_mult: 2.0
slow_latency_min_peers: 5

# CACCIA AL SOSTITUTO (anti-spreco): quando il best warm e' LENTO la catena
# fredda, la gara cerca candidati NUOVI; se non trova di meglio (vince A),
# backoff di hunt_backoff_sec per sessione+bucket (il buono NON esiste) e
# comunque al piu' hunt_max_per_window gare per hunt_window_sec.
hunt_backoff_sec: 600
hunt_max_per_window: 5
hunt_window_sec: 3600

# COLD SPREAD — sui soli dims vivi (esclusi -go/-fallback e gruppi capacita'):
# nasconde dal pool la quota TOP per numero di tentativi (ok+fail) nelle ultime
# 24h, cosi' il carico si distribuisce ANCHE sui provider poco usati a
# prescindere dalla colonna `order`. I deployment della sessione corrente
# (successi recenti, entro session_dep_guard_sec) sono sempre esentati.
# Attivo solo se il pool "a freddo" ha >= ladder_skip_after candidati e almeno
# un candidato ha gia' tentativi. 0.0 = disattivato.
cold_spread_pct: 0.20

# Risveglio di un dim in cooldown gia' alla PRIMA scelta (initial_pick), non
# solo lungo la scala: un dim stantio (age >= stale_cooldown_retry_sec) con il
# residuo minore viene riprovato prima di esc-win/ladder.
initial_pick_cooldown_wakeup: true

# ─────────────────────────────────────────────────────────────────────────────
# QUALITY CONTROL JSON + RETRY + WATCHDOG STREAMING
# ─────────────────────────────────────────────────────────────────────────────
qc_json:
  # Timeout in ms per il PRIMO byte di contenuto utile (prima si ruota).
  # 240000 = 4 min: i modelli con contesto lungo (200k+) possono impiegare
  # diversi minuti prima del primo token.
  stream_first_content_ms: 120000

  # ADATTIVO: la finestra sopra e' un TETTO. Con adaptive=true la deadline
  # effettiva per-deployment e':
  #     min(stream_first_content_ms, max(floor_ms, mult * EMA_latenza_dep))
  # Un dep normalmente veloce che stalla ruota presto; un dep strutturalmente
  # lento mantiene un margine proporzionato. EMA ignota -> usa il tetto.
  stream_first_content_adaptive: true
  stream_first_content_mult: 3.0        # deadline = mult * EMA del dep
  stream_first_content_floor_ms: 20000  # pavimento (>= 2000)
  # (watchdog anti-stall: vedi stream_stall_* TOP-LEVEL, calibrato sul TTFT)
  # hedge (SOLO stream, SOLO catena fredda al 1o tentativo, SOLO pre-commit):
  # se dopo tot ms A non ha ancora contenuto, si apre UN canary sul candidato
  # successivo e impegna chi dei due risponde primo; il perdente e' annullato
  # senza punizione, mai verso bucket pagati (-go/-fallback). 0 = spento.
  stream_hedge_delay_ms: 1500
  # Il ritardo e' ADATTIVO al bucket di contesto: su >128k il prefill e'
  # fisiologicamente lento (4-6s) e un canary a 1.5s sarebbe rumore. Il
  # delay effettivo = clamp(TTFT_p50_bucket * frac, min, max); se il TTFT
  # del bucket e' ignoto si usa stream_hedge_delay_ms.
  stream_hedge_ttft_frac: 0.6
  stream_hedge_min_ms: 800
  stream_hedge_max_ms: 2500
  # GARA quando la WARM non puo' aiutare (catena fredda, o holder lento che
  # la gara deve sostituire, o holder gia' provato): NON solo 1o tentativo.
  # cross_tier=true: i canary cercano candidati NUOVI su TIER crescenti
  # (mai sotto la dim richiesta, mai -go/-fallback, mai non-streaming noti);
  # se l'eletto e' il warm holder LENTO, i canary ESCLUDONO la lista warm
  # stessa e preferiscono i meno usati nelle 24h. tiers=2 => max 3 in volo.
  # max_races=0: una gara a ogni rotazione (limitata solo da deadline/tries).
  stream_hedge_cross_tier: true
  stream_hedge_tiers: 2
  stream_hedge_max_races: 0

  # Deadline totale in ms per l'INTERO stream (960000 = 16 minuti).
  stream_total_deadline_ms: 960000

  # Caratteri di risposta minimi per "impegnare" lo stream (evita di
  # consegnare risposte troncate/vuote; 40 = buon compromesso).
  stream_commit_min_chars: 40

  # PARACADUTE (-go/-fallback): True = sulla catena finale del ladder il
  # timeout sul primo contenuto NON scatta: lo stream parte comunque (non c'è
  # dove ruotare). False = comportamento legacy (timeout -> rotazione/503),
  # da usare solo se hai molte chiavi valide in quelle catene.
  stream_parachute_no_timeout: true

  # Cooldown in secondi del watchdog streaming dopo un errore (90s).
  watchdog_cooldown_sec: 90

  # Abilita QC JSON (validazione, strip fence, retry).
  enabled: true

  # Rimuove i fence ```json ... ``` dalle risposte prima di validare.
  strip_fences: true

  # Max tentativi totali (iniziale + retry) per ottenere JSON valido.
  max_attempts: 3

  # Annota il reasoning se il provider lo fornisce separatamente.
  annotate_reasoning: true

  # Retry automatico su errori 4xx dal provider (es. 400 per JSON invalido).
  retry_provider_4xx: true

  # Tier2 watchdog: logga warning se manca il marker [DONE] in streaming.
  #   false = solo log ; true = trattato come errore (sconsigliato)
  watchdog_mark_no_done: false

  # STRUTTURATO: degradazione gentile di response_format (json_schema).
  # Se il provider NON e' in native_schema_providers, il campo viene rimosso
  # e lo schema iniettato come istruzione nel prompt (evita il 400 upstream).
  downgrade_response_format: true
  native_schema_providers: ["openai", "azure"]

# ─────────────────────────────────────────────────────────────────────────────
# SANITY QC — scarta SOLO risposte vuote/triviali (non-streaming)
# ─────────────────────────────────────────────────────────────────────────────
# Il caso JSON rotto resta a qc_json. Nessun rilevamento di rifiuti (falsi pos.).
qc_sanity:
  # Ruota su risposta vuota causata da esaurimento token (length) — attivo.
  rotate_on_length_empty: true
  # Contenuto sotto questa lunghezza (dopo strip) viene considerato vuoto.
  min_chars: 1

# ─────────────────────────────────────────────────────────────────────────────
# TOOL REPAIR — normalizza la FORMA degli argomenti dei tool-call
# ─────────────────────────────────────────────────────────────────────────────
tool_repair:
  # Interruttore globale.
  enabled: true
  # Livello di default quando la colonna CSV `tool_repair` e' vuota.
  #   aggressive | safe | off
  default_level: aggressive
  # Google/Gemini gestiscono i tool a modo loro: off salvo override in CSV.
  disable_for_google: true
  # Limite dimensione (bytes) degli argomenti su cui tentare la riparazione.
  max_args_size: 100000
  # Annota il reasoning (D3) quando una risposta viene riparata.
  annotate_reasoning: false
  # --- FAKE TOOL-CALL: tool-call resi come TESTO nel content ---------------
  # Se la richiesta dichiara `tools` ma il modello scrive la chiamata come
  # testo (<arg_key>, <bash>, antml:...), il deployment viene marcato fallito
  # e si scala DIRETTAMENTE a -go/-fallback (niente scala dims). Sui gruppi
  # -go/-fallback la detection e' disattivata (anti-loop). A catena esaurita:
  # 503 retryable. Nessuna chiamata LLM di riparazione.
  fake_call:
    enabled: true
    max_escalations: 2
    stream_hold_max_bytes: 4096
    stream_hold_timeout_ms: 4000
    # patterns: ["<arg_key>", "<bash", "antml:"]   # override lista di default

# ─────────────────────────────────────────────────────────────────────────────
# ALIAS — mappatura nomi corti → modelli/gruppi reali (per comodità client)
# ─────────────────────────────────────────────────────────────────────────────
aliases:
  # "scrocco" = modello base del profilo (il router sceglie dimensione+velocità)
  scrocco: scrocco-llm-myteam
  # Varianti di contesto esplicito:
  scrocco-200k: scrocco-llm-myteam-200k
  scrocco-1000k: scrocco-llm-myteam-1000k

# ─────────────────────────────────────────────────────────────────────────────
# CAPACITÀ MODALITÀ — routing consapevole di immagini/video/audio/image_gen
# ─────────────────────────────────────────────────────────────────────────────
# Il gateway rileva le modalità richieste dal payload (image_url -> vision,
# input_audio -> audio, file video/* o video_url -> video) e instrada SOLO
# verso deployment il cui modello dichiara le capacità necessarie.
#
# ATTENZIONE: i pattern fnmatch confrontano l'INTERO nome modello upstream
# (post infer_model_prefix, quindi CON prefisso provider: es "qwen/qwen2.5-vl-72b").
# Usa un * iniziale se vuoi matchare a prescindere dal prefisso.
capability_routing:
  # Mappa pattern/modello-esatto -> capacità dichiarate.
  # Capacità ammesse: text, vision, video, audio, image_gen, tools, stt, tts,
  # image_edit (accetta un'immagine di riferimento: /v1/images/edits) e
  # image_multi_ref (accetta PIÙ immagini di riferimento).
  model_capabilities:
    Systran/faster-whisper-*: [stt]
    speaches-ai/piper-it_IT-*: [tts]
    openai/gpt-oss-120b: [text, tools]
    models/gemini-*-flash: [text, vision]
    "*qwen2.5-vl-*": [text, vision]
    "*kokoro*": [tts]
    "*piper*": [tts]
    whisper-large-v3*: [stt]
    models/gemini-*image: [image_gen, image_edit, image_multi_ref]
    "*nano-banana*": [image_gen, image_edit, image_multi_ref]

  # Capacità per modelli NON presenti nella mappa.
  # [text] = conservativo: richiesta con immagini -> 400 chiaro
  # (mai errore upstream criptico). Allarga dopo aver censito i modelli.
  capabilities_default: [text]

  # Token fittizi per la parte-immagine nella stima contesto (0 = ignora).
  image_token_estimate: 800

  # POST /v1/images/generations: se l'upstream non espone l'endpoint
  # (404/400 provider-side), ritenta via chat/completions.
  images_chat_fallback: true

  # /v1/images/edits e generations con reference: tetto di sicurezza sul numero
  # di immagini inviate ai modelli con capacità image_multi_ref.
  image_refs_hard_max: 16

# ─────────────────────────────────────────────────────────────────────────────
# IMMAGINI — store locale per il download (`url` NOSTRO) accanto a b64_json
# ─────────────────────────────────────────────────────────────────────────────
# Gli endpoint /v1/images/* restituiscono, per ogni immagine, sia `url` sia
# `b64_json`. L'`url` è SEMPRE del gateway (/v1/images/files/{id}): se l'upstream
# risponde in base64 l'immagine viene salvata nello store locale; se risponde con
# un URL http(s) del provider viene scaricata e ri-ospitata (mirror). Lo store è
# in memoria (stesso pattern dei job video): al restart gli URL già consegnati
# decadono (404). L'endpoint di download è PUBBLICO (id casuale unguessable).
images:
  store_enabled: true          # false = nessuno store, url provider intatto
  store_ttl_sec: 86400         # 0 = nessuna scadenza
  store_max_items: 500
  store_max_bytes: 536870912   # 512 MiB
  url_base: ""                 # vuoto -> derivato dalla request (Host/X-Forwarded-*)
  mirror_remote: true          # scarica e ri-ospita gli URL immagine dei provider
  remote_timeout_sec: 60
  remote_max_bytes: 20971520   # 20 MiB

# ─────────────────────────────────────────────────────────────────────────────
# RIMBORSO LATENZA — quando una risposta supera trigger_ms (soglia PROPRIA,
# indipendente dal floor "lento" della warm) le si "regalano" N turni sul
# bucket -go (come se il client avesse chiamato scrocco-llm-<profilo>-go).
# N = pct% dei turni totali della sessione, limitato tra min_turns e
# max_turns. Solo richieste di testo su un dim (-Nk). La variazione avviene
# all'atterraggio (scelta del gruppo): ladder e selezione restano INVARIATI.
# Indipendenza: un dep che serve in ~32s regala turni -go ma NON viene
# demoto (il floor "lento" resta 45s) -> resta warm/holder e si ritrova al
# ritorno dai turni regalo (cache calda). Vedi docs/CONFIGURATION.md.
# ─────────────────────────────────────────────────────────────────────────────
go_refund:
  enabled: true                # kill-switch del rimborso
  pct: 20                      # % dei turni totali della sessione
  min_turns: 1                 # minimo turni -go regalati
  max_turns: 5                 # massimo turni -go regalati
  trigger_ms: 20000            # soglia assoluta di regalo (ms); <=0 = off

# ─────────────────────────────────────────────────────────────────────────────
# GRUPPI CAPACITÀ STRUTTURALI — colonna CSV "caps" → -vision/-tts/-stt…
# ─────────────────────────────────────────────────────────────────────────────
# Ogni cap ha la terna <P>-C (free/priority) / -C-go (rinnovi) / -C-fallback
# (paid). Il token "text" nella colonna indica che il modello sta anche nei
# dims -Nk.
capability_groups:
  enabled: true             # ATTIVO in produzione (gruppi seedati nel CSV)
  on_missing: dynamic       # dynamic = filtro legacy se la cap non ha gruppo

# ─────────────────────────────────────────────────────────────────────────────
# FAIR-SHARE CHIAVI (gruppi capacità primary) — distribuisce uniformemente il
# RPM sulle chiavi gemelle dello stesso modello (es. le 5 chiavi groq whisper),
# invece di martellare la stessa chiave (winner-take-all della reputation) fino
# al 429. Si sceglie la chiave col MINOR numero di richieste nella finestra
# rolling `window_sec` (tie-break: inflight, model_preference, latenza EMA).
# Solo bucket primary (-C); esclude -C-go/-C-fallback. Default OFF.
# ─────────────────────────────────────────────────────────────────────────────
cap_fair_share:
  enabled: false            # accendere per attivare il fair-share
  caps: [stt]               # capacità a cui applicarlo (stt, tts, image_gen…)
  window_sec: 60            # ampiezza finestra rolling (60s = RPM)

# ─────────────────────────────────────────────────────────────────────────────
# PRICING — stima costi per /admin/insights (usata SOLO quando il provider
# non riporta un costo reale; chiave = pattern fnmatch sul modello)
# ─────────────────────────────────────────────────────────────────────────────
pricing:
  groq/*:
    prompt_per_1m: 0.05       # $ per milione di token di input
    completion_per_1m: 0.1    # $ per milione di token di output

# ─────────────────────────────────────────────────────────────────────────────
# CACHE-AWARE: detentore per-sessione + troncamento contesto selettivo
# ─────────────────────────────────────────────────────────────────────────────
cache_aware:
  enabled: true
  prefer_last_success: true
  holder_ttl_sec: 3600
  skip_probe_when_holder: true
  # prefix_audit: logga perche' il prefisso della conversazione E' CAMBIATO
  # tra due richieste della stessa sessione (identity/prefix): audit gratuito
  # contro le invalidazioni fantasma della cache (histnorm/ctxcompact/chiavi).
  prefix_audit: true
  context_truncation:
    enabled: true
    keep_turns: 4
    max_tool_output_chars: 2000
    # dedup (I2): duplicati riconosciuti sul contenuto NORMALIZZATO (date,
    # orari, ms e hex azzerati) oltre che sul tool_call_id; il rimando porta
    # `head:` con i primi 200 char, cosi' l'agente non ripete il comando.
    min_saved_tokens: 500
    # stub deterministico head+tail (0/0 = stub secco legacy)
    head_chars: 600
    tail_chars: 600
    # frontiera dinamica: protegge la coda finche' sta in keep_tail_pct%
    # della finestra del deployment scelto (0 = vale solo keep_turns)
    keep_tail_pct: 2.0
    # output con errori: MAI toccati (exit != 0, Traceback/...Error/Exception,
    # righe che iniziano con FAILED/ERROR/fatal: - pytest/git) + pattern reali
    # degli agent (case-insensitive): command not found / not found /
    # permission denied / access denied / no such file / timed out / timeout /
    # connection refused|reset / disk quota / read-only file system / killed /
    # ENOENT|EACCES|EPERM|ETIMEDOUT|ECONNREFUSED|ECONNRESET.
    # Gli output < 20 char prendono lo stub SECCO (senza head+tail) e non
    # vengono MAI gonfiati.
    keep_error_outputs: true
    # argomenti dei tool_calls vecchi: troncamento JSON-AWARE (il JSON resta
    # valido: si tagliano solo valori stringa sopra la soglia, con lo stesso
    # head+tail deterministico degli stub). 0 = mai toccare (storico)
    tool_args_max_chars: 2000
    # output JSON (liste/dict) con TROPPI elementi: troncamento STRUTTURATO
    # (primi json_struct_head + marker con totale + ultimi json_struct_tail),
    # cosi' l'agent trova un JSON VALIDO invece di uno spezzone ignorabile.
    # I3: riconosce anche il JSON dentro i fence markdown (```json) e, nei
    # dict, scende nel valore dominante ({"files": [...200...]}).
    # 0 = disattiva (torna al taglio a riga).
    json_struct_max_items: 40
    json_struct_head: 20
    json_struct_tail: 5
    # retention per citazione: un output vecchio NON viene stubbato se la coda
    # protetta cita ancora uno dei suoi token distintivi. I1: il token deve
    # essere path-like (contenere '/' o '.'), lungo >= 6 char, ripetuto
    # >= cite_min_freq volte e diverso da termini strutturali/nomi di tool;
    # il numero di token considerati e' dinamico (cap 300, ~len^2/10).
    cite_retention: true
    cite_min_freq: 3
    # headroom ABSOLUTO anticipato sui deployment reasoning-only (riga con
    # effort_capable): la soglia assoluta scatta a questa frazione MINORE
    # della finestra, lasciando token liberi per il blocco di thinking
    reasoning_headroom_ratio: 0.7
    # H3: riserva dedicata al blocco di thinking nel GATE di compattazione:
    # effective_ctx = ctx_est + reasoning_reserve_ratio * max_input, cosi' la
    # compattazione scatta PRIMA che il reasoning faccia sforare la finestra.
    # 0 = disattiva (comportamento storico).
    reasoning_reserve_ratio: 0.15
    # nuovi inneschi (oltre a max_input): soglia assoluta e cache fredda
    min_ctx_tokens: 50000
    on_deployment_switch: true
    switch_min_tokens: 8000
    stub_text: "[tool output omesso: {n} caratteri]"

# ─────────────────────────────────────────────────────────────────────────────
# SESSION-DEP GUARD — anti-usurpazione cross-sessione dei deployment free
# ─────────────────────────────────────────────────────────────────────────────
# Evita che sessioni concorrenti "premiano" gli stessi deployment free
# usurandoli (rate-limit/consumo). Si registra l'ULTIMA sessione che ha
# servito con SUCCESSO (non un semplice tentativo) ogni deployment free-dims;
# se un'ALTRA sessione l'ha usato meno di `sec` fa, quel deployment viene
# IGNORATO fra i vivi e reso eleggibile solo nel tier "pre-ultima-spiaggia"
# (fra l'ultimo -dim e il -go, ordinato per max_input crescente).
# Finche' la sessione e' VIVA i suoi deployment restano suoi (ownership
# rinnovata a ogni richiesta); `sec` di silenzio e l'intero set torna libero.
# Solo bucket free-dims: -go/-fallback e i gruppi capacita' non sono tracciati.
# Regola direzionale (ultimo successo): due sessioni che partono nello stesso
# istante possono collidere una volta, poi la vincente tiene il deployment.
session_dep_guard:
  enabled: true
  sec: 900

# WARM POOL (tier "caldi") — PRIMA del -dim richiesto e della scala si
# esauriscono i free-dims che QUESTA sessione ha gia' servito con SUCCESSO
# (ancora vivi, non in cooldown, che reggono need + max_input). Ordine interno:
# cache-holder di sessione, poi MRU (last_used), poi colonna `order`, poi
# max_input crescente. Vale per il routing automatico e per i dim espliciti
# (-Nk); NON per -go/-fallback (escalation deliberata a pagamento).
# `ttl_sec: 0` -> usa session_dep_guard_sec; `max_attempts: 0` -> illimitato
# (bounded dal set dei gia' tentati nella richiesta).
# GUARDIA DI LATENZA + FLOOR DIM: un dep con EMA di latenza sopra
# LATENCY_ROTATE_THRESHOLD_MS (90s), o andato lento per QUESTA sessione, NON
# entra nel tier caldo ne' resta come sticky/cache-holder: esce dai tier
# economici e (stessa sessione) torna pescabile solo all'ultimo scaglione
# (-fallback/ultima spiaggia). Inoltre il pool caldi non pesca mai una dim
# INFERIORE a quella richiesta: con `...-200k` esplicito ignora i caldi `-64k`
# della stessa sessione (il -Nk e' il minimo voluto dal client).
warm_pool:
  enabled: true
  ttl_sec: 0
  max_attempts: 0
  # P1: ammette i LENTI nel pool caldo/sticky/holder (il successo lento si
  # registra e la sessione lo conosce; la gara cerca il sostituito NUOVO).
  # Una chiave SATURA (soft-429/fault) resta sempre fuori. false = come
  # prima: i lenti escono dal warm.
  allow_slow: true
  # I canary mettono in CODA i candidati dei provider gia' "in uso" da UNA
  # QUALSIASI sessione — warm, probe/canaro in volo o chiamata reale in corso
  # (le chiavi in warm restano escluse sempre): true = prima tutti gli altri
  # provider, poi quelli gia' in uso. false = ordine legacy (nessuna coda).
  canary_warm_last: true

# ─────────────────────────────────────────────────────────────────────────────
# DEBUG — scatola nera input/output (solo per debug locale)
# Registra OGNI richiesta e risposta (SSE inclusa) in var/debug-sniff.log con
# rotazione ORARIA; retention = retention_hours ore (default 24).
# ATTENZIONE: contiene la conversazione COMPLETA (nessuna redazione).
debug:
  sniff:
    enabled: false          # true per attivare lo sniff
    retention_hours: 24     # file orari tenuti (default 24 = ultime 24h)
