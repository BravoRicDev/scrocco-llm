# scrocco-llm · configurazione ambiente (ESEMPIO)
# Copia questo file in .env.gateway e modifica i valori

# Ambiente: "development" (default) o "production".
# In produzione le chiavi client deterministiche sk-<profilo> sono DISATTIVATE
# e il gateway NON parte senza una configurazione sicura (master key reale +
# client_keys esplicite in var/gateway.yaml). Genera le chiavi con:
#   python scripts/gen_client_keys.py --write
# GATEWAY_ENV=development

# Master key ADMINISTRATIVA del gateway: MAI darla ai client.
# Generane una sicura (es. `openssl rand -hex 32` o `sk-master-...`).
# In produzione (GATEWAY_ENV=production) il placeholder qui sotto è rifiutato.
GATEWAY_MASTER_KEY=sk-master-CHANGE-ME-xxxxxxxxxxxxxxxx

# Porta su cui il gateway ascolta (default: 4001)
GATEWAY_PORT=4001

# Host su cui il gateway ascolta (default: 127.0.0.1 per sicurezza; usa 0.0.0.0 per esporre in LAN)
GATEWAY_HOST=127.0.0.1

# Intervallo in secondi per il watch del file CSV/keys (default: 5)
GATEWAY_WATCH_SECONDS=5

# Percorso del file CSV per la rotazione chiavi (fonte condivisa col vecchio sistema)
# GATEWAY_CSV=./var/keys_rotation.csv
GATEWAY_CSV=./var/keys_rotation.csv

# Percorso del file YAML con policy avanzate (profiling, health, QC, alias, ecc.)
GATEWAY_POLICY=./var/gateway.yaml

# Persisti statistiche su disco (1=sì, 0=no) — richiede GATEWAY_POLICY
GATEWAY_PERSIST_STATS=1

# Sniffing diagnostico header in ingresso (log [sniff] su var/gateway.log).
# Utile per verificare cosa invia il client (es. x-session-affinity di
# opencode). Lasciare NON impostato in produzione.
# SNIFF_HEADERS=1

# Attribuzione app OpenRouter (gate "agentic harness" sui modelli :free):
# OpenRouter serve i :free SOLO se la richiesta identifica un'app riconosciuta
# su openrouter.ai/apps via HTTP-Referer + X-Title. Default in policy
# (openrouter_app_referer/openrouter_app_title = opencode). Questi env
# sovrascrivono la policy senza toccare gateway.yaml.
# OPENROUTER_APP_REFERER=https://opencode.ai
# OPENROUTER_APP_TITLE=opencode